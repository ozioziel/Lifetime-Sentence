; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Lifetime Sentence"
config/description="Demo de terror psicológico retro PS1. GUILD Game Jam 2026."
config/version="1.0.0"
run/main_scene="res://ui/arranque.tscn"
config/features=PackedStringArray("4.7")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://icono.png"

[autoload]

Settings="*res://autoload/settings.gd"
Audio="*res://autoload/audio.gd"
RenderRig="*res://render/render_rig.tscn"
Juego="*res://autoload/juego.gd"
Guardado="*res://autoload/guardado.gd"
Interfaz="*res://autoload/interfaz.gd"
DebugTools="*res://autoload/debug_tools.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false
}

